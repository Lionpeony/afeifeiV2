{
  "name": "afeifei-v2",
  "productName": "Afeifei 阿飞飞",
  "version": "0.1.0",
  "description": "阿飞飞 Afeifei — 沉浸式音乐播放器（Windows）",
  "main": "dist/main.js",
  "author": "Afeifei",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "start": "node scripts/build.mjs && electron dist/main.js",
    "verify": "node scripts/verify.mjs",
    "dist": "node scripts/build.mjs && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@yakult-green-tea/qq-music-api": "^3.3.5",
    "music-metadata": "^7.14.0",
    "NeteaseCloudMusicApi": "^4.32.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "build": {
    "appId": "com.afeifei.player",
    "productName": "Afeifei",
    "asar": true,
 "asarUnpack": [
  "node_modules/NeteaseCloudMusicApi/**",
  "node_modules/@yakult-green-tea/qq-music-api/**"
 ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "unpackDirName": "Afeifei"
    }
  }
}
